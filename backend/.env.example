# ─────────────────────────────────────────────────────────────
# R-CPI backend environment — copy to .env and fill in values.
# ─────────────────────────────────────────────────────────────

# Core
NODE_ENV=development
PORT=5000
# Comma-separated list of trusted browser origins (apex + www + preview URLs).
FRONTEND_URL=http://localhost:5173
# Local dev: SQLite file. Production (Vercel): managed MySQL connection string.
# MySQL example: mysql://user:password@host:3306/dbname?sslaccept=strict
DATABASE_URL="file:./dev.db"

# Auth / security
JWT_ACCESS_SECRET=change_me_in_production
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_DAYS=7
BCRYPT_ROUNDS=12
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=30

# Rate limiting
API_RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# Vercel cron secret — sent as `Authorization: Bearer <CRON_SECRET>` when Vercel
# invokes /api/v1/cron/deadline-scan. Generate one with: openssl rand -hex 32
CRON_SECRET=

# AI (all optional — heuristic fallback works without them)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_TOKEN=

# ── Email (Resend) — https://resend.com/api-keys ──
# Set RESEND_API_KEY to send real emails (credentials + password resets).
# RESEND_FROM must be a verified domain in Resend, e.g. R-CPI <no-reply@rcpi.gov.rw>
# Until set, emails are logged to the backend console in dev.
RESEND_API_KEY=
RESEND_FROM=R-CPI <onboarding@resend.dev>

# ── SMS (Twilio) — https://console.twilio.com ──
# Set all three to send real SMS (password reset links + staff credentials).
# TWILIO_FROM_NUMBER is your Twilio number, e.g. +15075551234 (or a sender ID).
# Rwanda numbers are normalized: 0788123456 → +250788123456.
# Until set, SMS are logged to the backend console in dev.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
