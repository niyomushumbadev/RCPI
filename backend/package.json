{
  "name": "rcpi-backend",
  "version": "1.0.0",
  "private": true,
  "description": "R-CPI — Rwanda Community Problem Intelligence API",
  "main": "dist/index.js",
  "scripts": {
    "predev": "npm run db:push",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx tests/report.task3.test.ts",
    "test:e2e": "tsx ../scripts/e2e-workflow-test.ts",
    "prisma:generate": "node ../scripts/prisma-setup.js generate",
    "db:push": "node ../scripts/prisma-setup.js push",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "node ../scripts/prisma-setup.js generate && node ../scripts/prisma-setup.js push && tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.9.0",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
